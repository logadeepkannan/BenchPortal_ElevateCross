# Copy this file to .env and fill in the values below to connect Bench's
# Work Log & Issue Tracker modules to real SharePoint Online lists.
# See the "Connect SharePoint" tab under Architecture (Admin) in the app
# for full setup steps. Leave any value blank to keep using local demo data.

# Application (client) ID of your Microsoft Entra ID App Registration
# (Authentication platform: Single-page application; redirect URI: your dev/prod URL)
VITE_MSAL_CLIENT_ID=4b700fa5-1756-4812-a1d3-16efe41956c0

# Directory (tenant) ID (e.g. contoso.onmicrosoft.com, or the GUID from the
# App Registration's Overview page). Only use "common" if your app registration's
# "Supported account types" allows personal Microsoft accounts too.
VITE_MSAL_TENANT_ID=6ysgkq.onmicrosoft.com

# SharePoint site hostname, e.g. contoso.sharepoint.com
VITE_SP_HOSTNAME=6ysgkq.sharepoint.com

# Server-relative path to the site (NOT a full URL), e.g. /sites/BenchPortal
VITE_SP_SITE_PATH=/sites/BenchTeamPortal

# Base URL of the small server in /server, which checks a manual "Sign In"
# email against BenchAdministration (that server holds the Graph app-only
# credential — it can't live here, since Microsoft's identity platform
# refuses to issue that kind of token to a request with a browser Origin
# header). Leave blank to keep manual sign-in unavailable.
VITE_AUTH_API_URL=http://localhost:8787
